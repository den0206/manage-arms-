{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "background": {
    "service_worker": "browser/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extensionName__"
  },
  "options_page": "browser/tab.html",
  "permissions": [
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://skills.sh/*",
    "https://agentsdirectory.dev/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://codeload.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://skills.sh/*",
        "https://agentsdirectory.dev/*"
      ],
      "js": [
        "browser/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
