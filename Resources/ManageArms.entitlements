<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox は使わない。~/.claude ~/.cursor ~/.codex ~/.agents を読み書きし、
         claude / codex / gemini CLI を Process で起動するため（DESIGN.md 3.1 / 3.4）。
         → Mac App Store は選択肢にならない。Developer ID 署名 + 公証で直配布する。 -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- Hardened Runtime 下で Apple Events を送るのに要る（ブラウザ検知、DESIGN.md 6 章）。
         これが無いと署名済みビルドでだけ errAEEventNotPermitted になり、
         開発中は動くのに配布物で動かない、という一番見つけにくい壊れ方をする。 -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
